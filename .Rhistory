# Convert the XML document to a text string
xml_output <- as.character(target_doc)
# Use a string replacement to force the self-closing tags into HTML5 compliant open/close pairs
xml_output <- gsub('<span class="indent"/>', '<span class="indent"></span>', xml_output)
xml_output <- gsub('<br/>', '<br />', xml_output) # Adds the space before the slash for cleaner HTML formatting
# Write the final text to the designated target file
writeLines(xml_output, output_file)
