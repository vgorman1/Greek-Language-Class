install.packages("ncaavolleyballr")
setwd("~/Github/vg/vgorman_repos/Greek-Language-Class")
library(tidyverse)
library(rvest)
# 1. Identify all HTML files in your repo
html_files <- list.files(path = ".", pattern = "\\.html$", recursive = TRUE, full.names = TRUE)
# 2. Define the extraction and analysis function
analyze_repo_links <- function(file_path) {
# Read the HTML file
page <- read_html(file_path)
# Extract all anchor tags and their href attributes
nodes <- page %>% html_nodes("a")
hrefs <- nodes %>% html_attr("href")
link_text <- nodes %>% html_text(trim = TRUE)
if (length(hrefs) == 0) return(NULL)
# Create a table of links
tibble(
source_file = file_path,
text = link_text,
original_href = hrefs
) %>%
mutate(
# Categorize the link destination
type = case_when(
str_detect(original_href, "sharepoint\\.com") ~ "SharePoint",
str_detect(original_href, "github\\.com") ~ "GitHub (External)",
str_detect(original_href, "^http") ~ "Other External",
str_detect(original_href, "^#") ~ "Internal Anchor",
TRUE ~ "Local File"
),
# For Local Files, predict what the name SHOULD be now (lowercase + hyphens)
# We ignore external URLs here to keep them safe
predicted_href = ifelse(type == "Local File",
str_to_lower(original_href) %>% str_replace_all("[_ ]", "-"),
original_href),
# Check if the predicted file actually exists on your hard drive
# This calculates the path relative to the file the link is inside
exists_locally = map2_lgl(dirname(source_file), predicted_href, ~file.exists(file.path(.x, .y))),
# Flag if a rename is needed (e.g., if the link has spaces/underscores)
needs_rename = (type == "Local File" & original_href != predicted_href)
)
}
# 3. Run the analysis across all files
link_inventory <- map_df(html_files, analyze_repo_links)
# 4. Create a Summary table to see the damage
summary_stats <- link_inventory %>%
group_by(type) %>%
summarise(count = n())
View(summary_stats)
# Open the full list in a spreadsheet-style viewer
View(link_inventory)
githu
github_links <- link_inventory %>%
filter(type == "GitHub (External)") %>%
select(source_file, text, original_href)
View(github_links)
View(github_links)
# A "Wide Net" search for anything containing 'github'
all_github_links <- link_inventory %>%
filter(str_detect(original_href, fixed("github", ignore_case = TRUE)))
# Let's see what we found
print(paste("Total GitHub-related links found:", nrow(all_github_links)))
View(all_github_links)
# Create a 'Repair Map' for SharePoint links
sharepoint_map <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, text, original_href) %>%
mutate(
# Clean the text to see what the filename SHOULD be
suggested_filename = str_to_lower(text) %>%
str_replace_all("[^a-z0-9]", "-") %>%
str_replace_all("-+", "-") %>%
str_remove("-$")
)
View(sharepoint_map)
# 1. Refine the SharePoint Map with folder logic
sharepoint_repair_map <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, text, original_href) %>%
mutate(
# Determine the extension (checking the SharePoint URL for clues)
extension = case_when(
str_detect(original_href, "(?i)powerpoint|presentation|\\.pptx") ~ ".pptx",
str_detect(text, "(?i)presentation|slides") ~ ".pptx",
TRUE ~ ".md" # Defaulting to .md for handouts
),
# Determine the target folder
target_folder = case_when(
extension == ".pptx" ~ "../resources/presentations/",
TRUE ~ "../resources/handouts/"
),
# Standardize the filename from the link text
clean_filename = str_to_lower(text) %>%
str_replace_all("[^a-z0-9]", "-") %>%
str_replace_all("-+", "-") %>%
str_remove("-$"),
# Final Predicted Path
new_relative_path = paste0(target_folder, clean_filename, extension)
)
# 2. View the result
View(sharepoint_repair_map)
# Updated Repair Map that allows DOTS in the filename
sharepoint_repair_map <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, text, original_href) %>%
mutate(
extension = case_when(
str_detect(original_href, "(?i)powerpoint|presentation|\\.pptx") ~ ".pptx",
str_detect(text, "(?i)presentation|slides") ~ ".pptx",
TRUE ~ ".md"
),
target_folder = case_when(
extension == ".pptx" ~ "../resources/presentations/",
TRUE ~ "../resources/handouts/"
),
# NEW REGEX: [^a-z0-9.] means "Keep letters, numbers, and dots"
clean_filename = str_to_lower(text) %>%
str_replace_all("[^a-z0-9.]", "-") %>%
str_replace_all("-+", "-") %>%
str_replace_all("-\\.", ".") %>% # Clean up "-." to just "."
str_replace_all("\\.-", ".") %>% # Clean up ".-" to just "."
str_remove("-$"),
new_relative_path = paste0(target_folder, clean_filename, extension)
)
View(sharepoint_repair_map)
library(tidyverse)
# 1. Scan the actual physical folders for files
presentation_files <- list.files(path = "resources/presentations", full.names = TRUE, recursive = TRUE)
handout_files <- list.files(path = "resources/handouts", full.names = TRUE, recursive = TRUE)
# 2. Combine into a clean inventory
file_inventory <- tibble(full_path = c(presentation_files, handout_files)) %>%
mutate(
# Get just the filename for easy searching
filename = basename(full_path),
# Create the "Root-Relative" link for GitHub Pages
# This adds the repo name so the link works on the live site
gh_pages_link = paste0("/Greek-Language-Class/", full_path)
)
# 3. View the inventory
View(file_inventory)
# 1. Grab all files from the two resource folders
presentations <- list.files("resources/presentations", full.names = TRUE, recursive = TRUE)
handouts <- list.files("resources/handouts", full.names = TRUE, recursive = TRUE)
# 2. Build the data frame
link_repair_csv <- tibble(full_path = c(presentations, handouts)) %>%
mutate(
# The display name of the file
filename = basename(full_path),
# The part you need to paste (e.g., "resources/handouts/1.1-verbs.md")
selectable_path = full_path,
# The full URL for the final link
full_gh_link = paste0("/Greek-Language-Class/", full_path)
) %>%
# Sort alphabetically by filename to make searching easier
arrange(filename)
# 3. Save it as a CSV
write_csv(link_repair_csv, "link-repair-inventory.csv")
View(link_repair_csv)
library(tidyverse)
# 1. Get the list of actual physical files (The "Destinations")
physical_files <- tibble(
new_path = c(list.files("resources/presentations", full.names = TRUE),
list.files("resources/handouts", full.names = TRUE))
) %>%
mutate(
# Create a simplified version of the filename to help with matching
match_key = str_to_lower(basename(new_path)) %>%
str_replace_all("[^a-z0-9]", "")
)
# 2. Get the links found in your HTML (The "Sources")
# We use the inventory from earlier that contains 'source_file' and 'text'
link_todo_list <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, text) %>%
mutate(
# Simplify the link text to match the file names
match_key = str_to_lower(text) %>%
str_replace_all("(?i)powerpoint|handout", "") %>%
str_replace_all("[^a-z0-9]", "")
)
# 3. Join them together
final_repair_map <- link_todo_list %>%
left_join(physical_files, by = "match_key") %>%
mutate(
full_gh_link = paste0("/Greek-Language-Class/", new_path)
) %>%
select(source_file, link_text = text, full_gh_link) %>%
arrange(source_file)
View(final_repair_map)
library(tidyverse)
# 1. Map the ACTUAL files in your folders
physical_files <- tibble(
actual_path = c(list.files("resources/presentations", full.names = TRUE),
list.files("resources/handouts", full.names = TRUE))
) %>%
mutate(
# Create a matching key (lowercase, no dots, no spaces)
match_key = str_to_lower(basename(actual_path)) %>%
str_replace_all("[^a-z0-9]", "")
)
# 2. Map the LINKS that need fixing
link_todo <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, text) %>%
mutate(
# Create a matching key from the link text
match_key = str_to_lower(text) %>%
str_replace_all("(?i)powerpoint|handout", "") %>%
str_replace_all("[^a-z0-9]", "")
)
# 3. Join them to create the "Cheat Sheet"
final_repair_map <- link_todo %>%
left_join(physical_files, by = "match_key") %>%
mutate(
# THIS IS THE COLUMN YOU WILL COPY
path_to_copy = paste0("/Greek-Language-Class/", actual_path)
) %>%
select(source_file, link_text = text, path_to_copy)
View(final_repair_map)
library(tidyverse)
# 1. List every SharePoint link that needs a fix (The "Questions")
tasks <- link_inventory %>%
filter(type == "SharePoint") %>%
select(source_file, link_text = text) %>%
mutate(type = "TASK: Find path for this")
# 2. List every file you actually have (The "Answers")
# We list everything in presentations and handouts
resources <- tibble(
actual_path = c(list.files("resources/presentations", full.names = TRUE, recursive = TRUE),
list.files("resources/handouts", full.names = TRUE, recursive = TRUE))
) %>%
mutate(
link_text = basename(actual_path), # Using filename as the identifier
type = "RESOURCE: Copy this path",
full_gh_link = paste0("/Greek-Language-Class/", actual_path)
)
# 3. Combine them into one big searchable Master List
master_cheat_sheet <- bind_rows(tasks, resources) %>%
select(type, link_text, source_file, full_gh_link)
View(master_cheat_sheet)
