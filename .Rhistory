install.packages("ncaavolleyballr")
library(xml2)
# Source directory and target output file
# First, do no harm: The script only reads from this directory.
source_dir <- "D:/Documents/canonical-greekLit/data/tlg7000/tlg001"
output_file <- "D:/Documents/canonical-greekLit/data/extracted_anthology_clean.xml"
# Locate and parse all XML files in the source directory
xml_files <- list.files(source_dir, pattern = "\\.xml$", full.names = TRUE)
docs <- lapply(xml_files, read_xml)
# Define the exact list of 30 poems to extract
poems <- data.frame(
author = c("Lucillius", "Lucillius", "Nicarchus", "Ammianus", "Anonymous",
"Plato", "Leonidas of Tarentum", "Archias", "Callimachus", "Simonides",
"Palladas", "Glycon", "Callimachus", "Simonides", "Simonides",
"Anonymous", "Antipater of Sidon", "Leonidas of Tarentum", "Anyte", "Callimachus",
"Anyte", "Leonidas of Tarentum", "Callimachus", "Plato", "Anyte",
"Leonidas of Tarentum", "Evenus", "Antipater of Sidon", "Lucian", "Palladas"),
book = c(11, 11, 11, 11, 11, 6, 6, 6, 6, 6, 10, 10, 11, 7, 7,
7, 7, 7, 7, 7, 7, 7, 7, 9, 9, 9, 9, 9, 10, 10),
epigram = c("77", "257", "186", "226", "431", "1", "13", "16", "149", "197",
"72", "124", "362", "249", "253", "538", "6", "273", "208", "80",
"486", "652", "451", "823", "144", "322", "75", "58", "31", "84"),
stringsAsFactors = FALSE
)
# Helper function to locate a specific epigram across multiple XML documents
find_epigram <- function(docs_list, book_val, epigram_val) {
# TEI structure: div1 (book) -> div2 (chapter/epigram)
xpath <- sprintf(".//div1[@type='book' and @n='%s']//div2[@type='chapter' and @n='%s']", book_val, epigram_val)
for (doc in docs_list) {
node <- xml_find_first(doc, xpath)
if (!inherits(node, "xml_missing")) {
return(node)
}
}
return(NULL)
}
# Initialize the new target XML document
target_doc <- xml_new_document()
anthology_root <- xml_add_child(target_doc, "anthology")
# Iterate through the target list and build the new DOM hierarchy
for (i in seq_len(nrow(poems))) {
book_num <- poems$book[i]
ep_num <- poems$epigram[i]
author_name <- poems$author[i]
# Find the corresponding TEI node
ep_node <- find_epigram(docs, book_num, ep_num)
if (is.null(ep_node)) {
message(sprintf("Warning: Could not find Book %s, Epigram %s in the source files.", book_num, ep_num))
next
}
# Extract all <l> (line) nodes
line_nodes <- xml_find_all(ep_node, ".//l")
# Construct the wrapper and container
poem_wrapper <- xml_add_child(anthology_root, "div", class = "poem-wrapper")
poem_container <- xml_add_child(poem_wrapper, "div", class = "poem-container")
# Add Title heading (namespace removed)
title_text <- sprintf("%s, %s.%s", author_name, book_num, ep_num)
xml_add_child(poem_container, "h3", title_text)
# Add Paragraph for lines (namespace removed)
p_node <- xml_add_child(poem_container, "p")
for (j in seq_along(line_nodes)) {
# Apply indentation specifically for even-numbered lines (pentameter)
if (j %% 2 == 0) {
xml_add_child(p_node, "span", class = "indent")
}
# Clean whitespace and insert the Greek text
line_text <- trimws(xml_text(line_nodes[[j]]))
xml_add_child(p_node, "span", line_text, class = "verse-line")
# Append a <br/> tag after every line except the last
if (j < length(line_nodes)) {
xml_add_child(p_node, "br")
}
}
# Construct the commentary layout
note_id <- sprintf("notes-title-bk%s-ep%s", book_num, ep_num)
notes_container <- xml_add_child(poem_wrapper, "section", class = "notes-container", `aria-labelledby` = note_id)
xml_add_child(notes_container, "h2", "Commentary", class = "notes-header", id = note_id)
notes_body <- xml_add_child(notes_container, "div", class = "notes-body")
# (namespace removed from ul as well)
xml_add_child(notes_body, "ul")
}
# Write the final tree structure to the designated target file
write_xml(target_doc, output_file, options = "format")
message("Extraction complete. Output successfully saved to: ", output_file)
