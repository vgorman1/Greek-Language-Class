install.packages("httr")
install.packages("jsonlite")
# First, you need to install and load the required packages.
# install.packages(c("httr", "jsonlite"))
library(httr)
library(jsonlite)
# The URL of the API endpoint you want to call.
api_url <- "https://randomuser.me/api/"
# Make the GET request to the API.
# The 'GET()' function from 'httr' sends the request.
response <- GET(api_url)
# The 'content()' function extracts the content of the response.
# We then use 'fromJSON()' from 'jsonlite' to parse the JSON data.
data <- fromJSON(content(response, "text"))
# Now you can work with the data.
# This example prints the entire R list.
print(data)
# You can also access specific parts of the data, like the user's name.
first_name <- data$results$name$first
last_name <- data$results$name$last
print(paste("Random user's name:", first_name, last_name))
