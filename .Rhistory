# Define the absolute path to the root directory (using forward slashes for R)
base_dir <- "C:/Users/rgorm/OneDrive/Documents/Github/vg/vgorman_repos/Greek-Language-Class"
target_folders <- c("simple-sent", "complex-sentence", "resources")
# Initialize an empty data frame to store our results
file_data <- data.frame(
filename = character(),
filepath = character(),
stringsAsFactors = FALSE
)
# Loop through each target folder
for (folder in target_folders) {
# Construct the path to the current folder
current_dir <- file.path(base_dir, folder)
# Check if the directory actually exists to avoid errors
if (dir.exists(current_dir)) {
# Get relative paths for all files, including those in subdirectories
rel_paths <- list.files(current_dir, recursive = TRUE, full.names = FALSE)
# Skip to the next folder if this one is empty
if (length(rel_paths) == 0) next
# Extract just the isolated file name for the first column
filenames <- basename(rel_paths)
# Prepend "../" to create the web-ready path
web_paths <- paste0("../", rel_paths)
# Create a temporary data frame for the current folder
temp_df <- data.frame(
filename = filenames,
filepath = web_paths,
stringsAsFactors = FALSE
)
# Append it to our main data frame
file_data <- rbind(file_data, temp_df)
} else {
message(paste("Warning: The directory", current_dir, "was not found."))
}
}
# Set the working directory to the repo root so the CSV saves there
setwd(base_dir)
file_data
rm(list = ls())
# Define the absolute path to the root directory
base_dir <- "C:/Users/rgorm/OneDrive/Documents/Github/vg/vgorman_repos/Greek-Language-Class"
target_folders <- c("simple-sent", "complex-sentence", "resources")
# Initialize an empty data frame to store our results
file_data <- data.frame(
filename = character(),
filepath = character(),
stringsAsFactors = FALSE
)
# Loop through each target folder
for (folder in target_folders) {
# Construct the path to the current folder
current_dir <- file.path(base_dir, folder)
if (dir.exists(current_dir)) {
# Get relative paths for all files
# This natively provides only the filename, unless a subfolder is involved
rel_paths <- list.files(current_dir, recursive = TRUE, full.names = FALSE)
if (length(rel_paths) == 0) next
# Extract just the isolated file name for the first column
filenames <- basename(rel_paths)
# Create a temporary data frame with the clean relative paths
temp_df <- data.frame(
filename = filenames,
filepath = rel_paths,
stringsAsFactors = FALSE
)
# Append it to our main data frame
file_data <- rbind(file_data, temp_df)
} else {
message(paste("Warning: The directory", current_dir, "was not found."))
}
}
# Set the working directory to the repo root so the CSV saves there
setwd(base_dir)
final
file_data
message("CSV successfully generated in the Greek-Language-Class root directory!")
setwd("~/Github/vg/vgorman_repos/Greek-Language-Class")
# Export the final data frame to a CSV file
write.csv(file_data, "github_web_paths.csv", row.names = FALSE)
