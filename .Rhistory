# The base URL for the Alpheios Morphology API.
api_url <- "https://morph.alpheios.net/api/v1/analysis/word"
# --- Example 1: Latin Word ---
cat("--- Looking up Latin word 'puellam' ---\n")
# Define the parameters for the API call in a named list.
latin_params <- list(
word = "puellam",
lang = "lat",
engine = "whitakerLat",
clientId = "my-r-script"
)
# Make the GET request with the parameters.
# The `query` argument automatically appends the parameters to the URL.
response_latin <- GET(api_url, query = latin_params)
response_latin
# Check for a successful response (status 200).
if (http_error(response_latin)) {
stop("API request failed with status code ", status_code(response_latin))
}
# Parse the JSON response into an R list.
data_latin <- fromJSON(content(response_latin, "text", encoding = "UTF-8"))
data_latin
# Print the analysis results.
print(data_latin)
cat("\n------------------------------------\n\n")
# --- Example 2: Greek Word ---
cat("--- Looking up Greek word 'logos' ---\n")
# Define the parameters for the Greek API call.
greek_params <- list(
word = "logos",
lang = "grc",
engine = "morpheusgrc",
clientId = "my-r-script"
)
# Make the GET request.
response_greek <- GET(api_url, query = greek_params)
# Check for a successful response.
if (http_error(response_greek)) {
stop("API request failed with status code ", status_code(response_greek))
}
# Parse the JSON response.
data_greek <- fromJSON(content(response_greek, "text", encoding = "UTF-8"))
# Print the analysis results.
print(data_greek)
# Print the analysis results.
