4, 51, 6,
7, 8, 9,
10, 11, 12
), ncol=3, byrow=TRUE)
# Mean vector of the data
mean_vector <- colMeans(data)
# Covariance matrix of the data
cov_matrix <- cov(data)
# Point for which we want to calculate the Mahalanobis distance
point <- c(5, 5, 5)
# Calculate the Mahalanobis distance
mahalanobis_dist <- mahalanobis(point, mean_vector, cov_matrix)
# Print the result
print(mahalanobis_dist)
View(cov_matrix)
